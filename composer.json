{
    "name": "cinderwatch/cinder-laravel",
    "description": "Laravel adapter for Cinder error, log, trace, health and schedule monitoring.",
    "keywords": [
        "cinder",
        "laravel",
        "errors",
        "health",
        "monitoring",
        "cinderwatch"
    ],
    "homepage": "https://github.com/cinderwatch-dev/cinder-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Rhys Lees",
            "email": "43909932+RhysLees@users.noreply.github.com",
            "homepage": "https://www.rhyslees.co.uk",
            "role": "Software Engineer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "cinderwatch/cinder-php": "^1.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Cinderwatch\\Laravel\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cinderwatch\\Laravel\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cinderwatch\\Laravel\\CinderServiceProvider"
            ],
            "aliases": {
                "Cinder": "Cinderwatch\\Laravel\\Facades\\Cinder"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=100",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "cinder-php": {
            "type": "path",
            "url": "../cinder-php"
        }
    }
}
